{
  "name": "team-task-manager",
  "version": "1.0.0",
  "description": "Full-stack team task manager with role-based access (Admin/Member)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:client": "cd client && npm run dev",
    "start": "node src/server.js",
    "build": "npm run install:client && npm run build:client && npm run prisma:generate",
    "install:client": "cd client && npm install",
    "build:client": "cd client && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
